// app/api/dashboard/route.ts
import { NextResponse } from "next/server";
import prisma from "@/lib/prisma";
import { requireCompanyScope } from "@/lib/session";
import { hasAnyPermission } from "@/lib/auth";
import { PERMISSIONS } from "@/config/roles";
import { startOfMonth, subMonths } from "date-fns";

// Tipos de respuesta para el cliente
export type DashboardData = {
  role: "ADMIN" | "MANAGER" | "EMPLOYEE";
  kpis: {
    label: string;
    value: string | number;
    trend?: number; // % cambio
    status?: "success" | "warning" | "danger" | "neutral";
    icon?: string;
  }[];
  charts: {
    burnoutTrend: any[];
    taskDistribution: any[];
  };
  actionItems: {
    id: string;
    title: string;
    type: "SURVEY" | "TASK" | "REVIEW" | "INFO";
    link?: string;
  }[];
};

export async function GET(req: Request) {
  const { user, companyId } = await requireCompanyScope();

  // Detectar Rol Principal basado en permisos
  let roleType: "ADMIN" | "MANAGER" | "EMPLOYEE" = "EMPLOYEE";
  if (hasAnyPermission(user, [PERMISSIONS.COMPANIES_MANAGE]))
    roleType = "ADMIN";
  else if (hasAnyPermission(user, [PERMISSIONS.TEAM_MANAGE]))
    roleType = "MANAGER";

  const now = new Date();
  const lastMonth = startOfMonth(subMonths(now, 1));

  // --- LÓGICA PARA ADMINISTRADORES ---
  if (roleType === "ADMIN") {
    // 1. Totales Globales
    const [totalUsers, totalTeams, activeCampaigns] = await Promise.all([
      prisma.user.count({ where: { companyId, status: "ACTIVE" } }),
      prisma.team.count({ where: { companyId } }),
      prisma.campaign.count({ where: { companyId, status: "ACTIVE" } }),
    ]);

    // 2. Riesgo Global (Último snapshot promedio)
    const riskStats = await prisma.workloadSnapshot.groupBy({
      by: ["riskLevel"],
      where: { user: { companyId }, weekStart: { gte: lastMonth } },
      _count: true,
    });
    const criticalCount =
      riskStats.find((r) => r.riskLevel === "CRITICAL")?._count ?? 0;

    return NextResponse.json({
      role: "ADMIN",
      kpis: [
        {
          label: "Empleados Activos",
          value: totalUsers,
          icon: "users",
          status: "neutral",
        },
        {
          label: "Equipos",
          value: totalTeams,
          icon: "grid",
          status: "neutral",
        },
        {
          label: "Campañas Activas",
          value: activeCampaigns,
          icon: "activity",
          status: "success",
        },
        {
          label: "Riesgo Crítico",
          value: criticalCount,
          icon: "alert",
          status: criticalCount > 0 ? "danger" : "success",
        },
      ],
      charts: {
        // Simulación de tendencia (idealmente sería una query groupBy date)
        burnoutTrend: [
          { name: "Semana 1", value: 65 },
          { name: "Semana 2", value: 59 },
          { name: "Semana 3", value: 80 },
          { name: "Semana 4", value: 81 },
        ],
        taskDistribution: [],
      },
      actionItems:
        criticalCount > 0
          ? [
              {
                id: "risk-1",
                title: `${criticalCount} empleados en riesgo de burnout`,
                type: "REVIEW",
                link: "/team/workload",
              },
            ]
          : [],
    } as DashboardData);
  }

  // --- LÓGICA PARA MANAGERS ---
  if (roleType === "MANAGER") {
    // Mis equipos
    const myTeams = await prisma.team.findMany({
      where: {
        companyId,
        OR: [
          { leadId: user.id },
          { memberships: { some: { userId: user.id } } },
        ],
      },
      select: { id: true, name: true },
    });
    const teamIds = myTeams.map((t) => t.id);

    // Miembros
    const members = await prisma.teamMembership.findMany({
      where: { teamId: { in: teamIds } },
      select: { userId: true },
    });
    const memberIds = members.map((m) => m.userId);

    // Carga del equipo
    const blockedTasks = await prisma.task.count({
      where: { ownerId: { in: memberIds }, status: "BLOCKED" },
    });

    // Burnout promedio del equipo (última encuesta)
    const latestResponses = await prisma.surveyResponse.findMany({
      where: { userId: { in: memberIds } },
      orderBy: { submittedAt: "desc" },
      take: memberIds.length, // Aproximación rápida
      select: { scoreTotal: true },
    });
    const avgScore =
      latestResponses.length > 0
        ? Math.round(
            latestResponses.reduce((a, b) => a + Number(b.scoreTotal), 0) /
              latestResponses.length
          )
        : 0;

    return NextResponse.json({
      role: "MANAGER",
      kpis: [
        {
          label: "Equipos a cargo",
          value: myTeams.length,
          icon: "grid",
          status: "neutral",
        },
        {
          label: "Miembros",
          value: memberIds.length,
          icon: "users",
          status: "neutral",
        },
        {
          label: "Score de Estrés",
          value: avgScore,
          icon: "activity",
          status: avgScore > 60 ? "danger" : "success",
        },
        {
          label: "Bloqueos",
          value: blockedTasks,
          icon: "alert",
          status: blockedTasks > 0 ? "warning" : "success",
        },
      ],
      charts: {
        burnoutTrend: [], // Implementar historial real si se desea
        taskDistribution: [],
      },
      actionItems:
        blockedTasks > 0
          ? [
              {
                id: "block-1",
                title: `Hay ${blockedTasks} tareas bloqueadas en el equipo`,
                type: "TASK",
                link: "/team/workload",
              },
            ]
          : [],
    } as DashboardData);
  }

  // --- LÓGICA PARA EMPLEADOS ---
  // Tareas mías
  const myTasks = await prisma.task.groupBy({
    by: ["status"],
    where: { ownerId: user.id },
    _count: true,
  });

  const pending = myTasks.find((t) => t.status === "PENDING")?._count ?? 0;
  const inProgress =
    myTasks.find((t) => t.status === "IN_PROGRESS")?._count ?? 0;
  const done = myTasks.find((t) => t.status === "DONE")?._count ?? 0;

  // Encuestas pendientes
  const pendingSurveys = await prisma.campaign.count({
    where: {
      companyId,
      status: "ACTIVE",
      // Lógica simplificada de target (se puede refinar con la funcion isUserInTarget)
      endDate: { gte: now },
    },
    // Nota: Filtrar las ya respondidas requeriría una query más compleja,
    // para el dashboard rápido esto es un "indicador de actividad".
  });

  return NextResponse.json({
    role: "EMPLOYEE",
    kpis: [
      { label: "Por hacer", value: pending, icon: "list", status: "neutral" },
      { label: "En curso", value: inProgress, icon: "play", status: "primary" },
      { label: "Completadas", value: done, icon: "check", status: "success" },
      {
        label: "Encuestas",
        value: pendingSurveys,
        icon: "file",
        status: pendingSurveys > 0 ? "warning" : "neutral",
      },
    ],
    charts: {
      taskDistribution: [
        { name: "Pendiente", value: pending, fill: "#94a3b8" },
        { name: "En curso", value: inProgress, fill: "#3b82f6" },
        { name: "Listo", value: done, fill: "#10b981" },
      ],
      burnoutTrend: [],
    },
    actionItems: [],
  } as DashboardData);
}
