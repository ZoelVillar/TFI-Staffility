// app/api/team/my/route.ts
import { NextResponse } from "next/server";
import prisma from "@/lib/prisma";
import { requireCompanyScope } from "@/lib/session";
import { hasAnyPermission } from "@/lib/auth";
import { PERMISSIONS } from "@/config/roles";

export async function GET(req: Request) {
  const { user, companyId } = await requireCompanyScope();
  const { searchParams } = new URL(req.url);
  const q = searchParams.get("q")?.trim() ?? "";

  // Determinar si el usuario tiene privilegios de "Vista Global" de equipos
  const canViewAll = hasAnyPermission(user, [
    PERMISSIONS.TEAM_MANAGE,
    PERMISSIONS.TEAM_VIEW,
    PERMISSIONS.SYSTEM_COMPANIES_MANAGE // Admin fallback
  ]);

  let teams = [];

  const selectFields = {
    id: true,
    name: true,
    description: true,
    leadId: true,
    lead: { select: { id: true, name: true, email: true, image: true } },
    _count: { select: { memberships: true } },
    createdAt: true,
  };

  if (canViewAll) {
    // CASO 1: Manager/Admin -> Ve todos los equipos de la empresa
    teams = await prisma.team.findMany({
      where: {
        companyId,
        ...(q ? { name: { contains: q, mode: "insensitive" } } : {}),
      },
      select: selectFields,
      orderBy: { name: "asc" },
    });
  } else {
    // CASO 2: Empleado -> Ve solo equipos donde es miembro
    const memberships = await prisma.teamMembership.findMany({
      where: { 
        userId: user.id, 
        team: { 
          companyId,
          ...(q ? { name: { contains: q, mode: "insensitive" } } : {}),
        } 
      },
      select: { team: { select: selectFields } },
      orderBy: { team: { name: "asc" } },
    });
    teams = memberships.map((m) => m.team);
  }

  // Calcular KPIs en tiempo real para el dashboard
  const kpis = {
    totalTeams: teams.length,
    totalMembers: teams.reduce((a, t) => a + t._count.memberships, 0),
    teamsLead: teams.filter((t) => t.leadId === user.id).length,
    avgMembers: teams.length > 0 
      ? Math.round(teams.reduce((a, t) => a + t._count.memberships, 0) / teams.length) 
      : 0
  };

  return NextResponse.json({ teams, kpis, isManager: canViewAll });
}
